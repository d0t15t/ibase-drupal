<?php

use Drupal\Core\Form\FormStateInterface;

function the_content_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id == 'node_artist_edit_form' || $form_id == 'node_artist_form') {
    $form['actions']['submit']['#submit'][] = '_the_content_artist_form_submit_handler';
  }

  if (isset($form["field_dimensions"]['widget'][0])) {
    $arr = $form["field_dimensions"]['widget'][0];
    $arr['value']['#access'] = FALSE;
    $order = ['height', 'width', 'length'];
    $newOrder = [];
    foreach ($order as $key) {
      if (isset($arr[$key])) {
        $newOrder[$key] = $arr[$key];
      }
    }
    foreach ($arr as $key => $value) {
      if (!in_array($key, $order)) {
        $newOrder[$key] = $value;
      }
    }
    $form["field_dimensions"]['widget'][0] = $newOrder;
  }
}

/**
 * Custom submit handler for the 'artist' node type.
 */
function _the_content_artist_form_submit_handler(&$form, FormStateInterface $form_state) {
  try {
    $node = $form_state->getFormObject()->getEntity();
    $name_fields = ['field_name', 'field_name_asian'];
    $name_fields_values = array_map(function ($f) use ($node) {
      if (!$node->hasField($f)) return '';
      if ($node->get($f)->isEmpty()) return '';
      $field_values = $node->get($f)->get(0)->getValue();
      unset($field_values['title']);
      return trim(array_reduce($field_values, fn($c, $e) => "$c $e"));
    }, $name_fields);
    $node_title = trim(array_reduce($name_fields_values, fn($c, $f) => "$c $f"));
//    $node->setTitle($node_title);
//    $node->save();
  } catch (\Exception $e) {
    \Drupal::logger('the_content')->error('An error occurred: @message', ['@message' => $e->getMessage()]);
  }
}

function the_content_preprocess_field(&$vars) {
  $field_name = $vars["element"]["#field_name"];
  $formatter = $vars["element"]["#formatter"];
  $entity = $vars["element"]["#object"];

  if ($field_name === 'field_dimensions') {
    $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
    foreach ($vars["items"] as &$item) {
      $components = ['height', 'width', 'length'];
      foreach ($components as $component) {
        if (isset($item["content"]["#$component"])) {
          $value = $item["content"]["#$component"];
          // If the value is a round number (example: 18.00) then only display 18
          if (is_numeric($value) && (float) $value == (int) $value) {
            $item["content"]["#$component"] = (string) (int) $value;
          }
          elseif (is_numeric($value) && $langcode === 'de') {
            // German uses comma as decimal point.
            $item["content"]["#$component"] = str_replace('.', ',', (string) $value);
          }

          // Hide empty length values.
          if ($component === 'length' && $item["content"]["#$component"] === '0') {
            $item["content"]["#$component"] = NULL;
          }
        }
      }
    }

    // Show dimensions unit from parent.
    if (isset($vars["element"]["#object"])) {
      $parent = $vars["element"]["#object"];
      if ($parent->hasField('field_dimensions_unit') && !$parent->get('field_dimensions_unit')->isEmpty()) {
        $unit = $parent->get('field_dimensions_unit')->getString();
        $vars["items"][0]['content']['#unit']  = $unit;
      }
    }
  }

}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function the_content_theme_suggestions_volume_components_field_formatter_alter(array &$suggestions, array &$variables) {
  $suggestions[] = 'volume_components_field_formatter__the';
}

/**
 * Implements hook_theme().
 */
function the_content_theme($existing, $type, $theme, $path) {
  return [
    'volume-components-field-formatter--the' => [
      'base hook' => 'volume-components-field-formatter',
    ],
  ];
}

/**
 * Implements hook_metatags_alter().
 *
 * Auto-generates meta descriptions for content types that lack one.
 */
function the_content_metatags_alter(array &$metatags, array &$context): void {
  if (!isset($context['entity']) || !$context['entity'] instanceof \Drupal\node\NodeInterface) {
    return;
  }
  $node = $context['entity'];

  // Per-node overrides (hand-written).
  $overrides = [
    2   => 'THE gallery is an institution in the rural Bamberg region. Curator Thomas Eller presents contemporary art in a historic water mill in the Itz valley.',
    242 => 'Browse current and past exhibitions at THE Gallery, featuring contemporary art in the Itz valley, Bamberg region.',
  ];
  if (isset($overrides[$node->id()])) {
    $metatags['description'] = $overrides[$node->id()];
    return;
  }

  // Auto-generate by content type.
  $desc = _the_content_generate_meta_description($node);
  if ($desc) {
    $metatags['description'] = $desc;
  }
}

/**
 * Generates a meta description for a node based on its content type.
 */
function _the_content_generate_meta_description(\Drupal\node\NodeInterface $node): ?string {
  $title = $node->getTitle();
  switch ($node->bundle()) {
    case 'artist':
      return "Explore works by $title at THE Gallery — contemporary art in the Itz valley, Bamberg region.";

    case 'artwork':
      $parts = [$title];
      if ($node->hasField('field_artists') && !$node->get('field_artists')->isEmpty()) {
        $artist = $node->get('field_artists')->entity;
        if ($artist) {
          $parts[] = 'by ' . $artist->getTitle();
        }
      }
      if ($node->hasField('field_year') && !$node->get('field_year')->isEmpty()) {
        $parts[] = $node->get('field_year')->value;
      }
      return implode(', ', $parts) . ' — artwork in THEcollection at THE Gallery.';

    case 'exhibition':
      // Truncate body text to ~155 chars.
      if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
        $plain = strip_tags($node->get('body')->value);
        $plain = html_entity_decode($plain, ENT_QUOTES, 'UTF-8');
        $plain = preg_replace('/\s+/', ' ', trim($plain));
        // Remove leading &nbsp; or non-breaking spaces.
        $plain = str_replace("\xC2\xA0", ' ', $plain);
        $plain = trim($plain);
        if (mb_strlen($plain) > 155) {
          $plain = mb_substr($plain, 0, 152) . '...';
        }
        return $plain;
      }
      // Fallback: build from artists.
      if ($node->hasField('field_artists') && !$node->get('field_artists')->isEmpty()) {
        $names = [];
        foreach ($node->get('field_artists') as $ref) {
          if ($ref->entity) {
            $names[] = $ref->entity->getTitle();
          }
        }
        if ($names) {
          $list = count($names) > 3
            ? implode(', ', array_slice($names, 0, 3)) . ' and others'
            : implode(', ', $names);
          return "$title — featuring $list. Exhibition at THE Gallery.";
        }
      }
      return "$title — exhibition at THE Gallery, contemporary art in the Itz valley.";

    case 'workgroup':
      return "$title — a curated group of works at THE Gallery, Itz valley.";

    default:
      // For page and other types, truncate body if available.
      if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
        $plain = strip_tags($node->get('body')->value);
        $plain = preg_replace('/\s+/', ' ', trim($plain));
        if (mb_strlen($plain) > 155) {
          $plain = mb_substr($plain, 0, 152) . '...';
        }
        return $plain;
      }
      return NULL;
  }
}
