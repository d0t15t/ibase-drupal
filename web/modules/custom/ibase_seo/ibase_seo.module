<?php

/**
 * @file
 * Structured data and page-specific meta tags for the ibase sites.
 */

use Drupal\Component\Serialization\Json;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_page_attachments().
 *
 * Adds a schema.org JSON-LD graph to every front-end page.
 */
function ibase_seo_page_attachments(array &$attachments): void {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }
  /** @var \Drupal\ibase_seo\SchemaBuilder $builder */
  $builder = \Drupal::service('ibase_seo.schema_builder');
  $graph = $builder->buildPageGraph();
  if (!$graph) {
    return;
  }
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => Json::encode($graph),
    ],
    'ibase_seo_jsonld',
  ];

  // Geo meta tags for local search.
  $org = $builder->settings()->get('organization') ?: [];
  if (!empty($org['latitude']) && !empty($org['longitude'])) {
    $geo = [
      'geo.region' => $org['region_code'] ?? '',
      'geo.placename' => $org['locality'] ?? '',
      'geo.position' => $org['latitude'] . ';' . $org['longitude'],
      'ICBM' => $org['latitude'] . ', ' . $org['longitude'],
    ];
    foreach (array_filter($geo) as $name => $content) {
      $attachments['#attached']['html_head'][] = [
        [
          '#type' => 'html_tag',
          '#tag' => 'meta',
          '#attributes' => ['name' => $name, 'content' => $content],
        ],
        'ibase_seo_' . $name,
      ];
    }
  }
  $builder->getCacheability()->applyTo($attachments);
}

/**
 * Implements hook_preprocess_html().
 *
 * Declares the language the content is written in, when that differs from
 * the language the site was set up in.
 */
function ibase_seo_preprocess_html(array &$variables): void {
  $langcode = \Drupal::config('ibase_seo.settings')->get('content_langcode');
  if ($langcode && !\Drupal::service('router.admin_context')->isAdminRoute()) {
    $variables['html_attributes']['lang'] = $langcode;
  }
  $variables['#cache']['tags'][] = 'config:ibase_seo.settings';
}

/**
 * Implements hook_views_pre_render().
 *
 * Adds a schema.org ItemList for the listings named in the settings, such
 * as the current exhibitions or the archive.
 */
function ibase_seo_views_pre_render(ViewExecutable $view): void {
  $lists = \Drupal::config('ibase_seo.settings')->get('item_list_views') ?: [];
  $display = $view->id() . ':' . $view->current_display;
  if (!in_array($display, $lists, TRUE) && !in_array($view->id() . ':*', $lists, TRUE)) {
    return;
  }
  $entities = [];
  foreach ($view->result as $row) {
    if ($row->_entity instanceof NodeInterface || $row->_entity instanceof TermInterface) {
      $entities[$row->_entity->id()] = $row->_entity;
    }
  }
  if (!$entities) {
    return;
  }
  /** @var \Drupal\ibase_seo\SchemaBuilder $builder */
  $builder = \Drupal::service('ibase_seo.schema_builder');
  $name = $builder->plainText((string) ($view->getTitle() ?: $view->storage->label()), 110);
  $offset = (int) ($view->pager ? $view->pager->getCurrentPage() * $view->pager->getItemsPerPage() : 0);
  $view->element['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => Json::encode($builder->itemList($entities, $name, $offset)),
    ],
    'ibase_seo_itemlist_' . $view->id() . '_' . $view->current_display,
  ];
}

/**
 * Implements hook_metatags_alter().
 *
 * Fills in the description, image and type tags from the node itself, so
 * every page shares well without per-node metatag configuration.
 */
function ibase_seo_metatags_alter(array &$metatags, array &$context): void {
  /** @var \Drupal\ibase_seo\SchemaBuilder $builder */
  $builder = \Drupal::service('ibase_seo.schema_builder');
  $locales = ['de' => 'de_DE', 'en' => 'en_GB', 'zh-hans' => 'zh_CN'];
  $metatags['og_locale'] = $locales[$builder->langcode()] ?? $builder->langcode();

  $entity = $context['entity'] ?? NULL;
  if ($entity instanceof TermInterface && $builder->isPersonTerm($entity)) {
    $metatags['description'] = $builder->termDescription($entity);
    $metatags['og_type'] = 'profile';
    return;
  }
  $node = $entity;
  if (!$node instanceof NodeInterface) {
    return;
  }

  $front = (string) \Drupal::config('system.site')->get('page.front');
  $is_front = $front === '/node/' . $node->id();

  // The front page is described by the site description.
  if (!$is_front && ($description = $builder->description($node))) {
    $metatags['description'] = $description;
  }

  if (!$is_front && ($image = $builder->image($node))) {
    $metatags['og_image'] = $image['url'];
    $metatags['og_image_secure_url'] = $image['url'];
    $metatags['og_image_type'] = $image['type'];
    $metatags['og_image_width'] = (string) $image['width'];
    $metatags['og_image_height'] = (string) $image['height'];
    $metatags['og_image_alt'] = $image['alt'] ?: $node->label();
    $metatags['twitter_cards_image'] = $image['url'];
    $metatags['twitter_cards_image_alt'] = $image['alt'] ?: $node->label();
    $metatags['image_src'] = $image['url'];
  }

  $metatags['og_type'] = match (TRUE) {
    $is_front => 'website',
    $node->bundle() === 'artist' => 'profile',
    in_array($node->bundle(), ['article', 'exhibition', 'events'], TRUE) => 'article',
    default => 'website',
  };
  if ($metatags['og_type'] === 'article') {
    $metatags['article_published_time'] = date('c', (int) $node->getCreatedTime());
    $metatags['article_modified_time'] = date('c', (int) $node->getChangedTime());
  }
}
